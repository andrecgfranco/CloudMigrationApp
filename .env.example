# ─────────────────────────────────────────────────────────────────────────────
# Port Configuration (Docker Compose)
# This is the single source of truth for local development
# Copy to .env and adjust as needed
# ─────────────────────────────────────────────────────────────────────────────

# AUTH-FORUM SERVICE (Port 8082)
AUTH_FORUM_SERVER_PORT=8082

# LOCATION SERVICE (Port 8080 HTTP, 50051 gRPC)
LOCATION_SERVER_PORT=8080
LOCATION_GRPC_PORT=50051

# USER SERVICE (Port 8081 HTTP, 50053 gRPC)
USER_SERVER_PORT=8081
USER_GRPC_PORT=50053

# SEARCH SERVICE (Port 8083 HTTP, 50052 gRPC)
SEARCH_SERVER_PORT=8083
SEARCH_GRPC_PORT=50052

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_HOST=pg_database
POSTGRES_PORT=5432
POSTGRES_DB=myDB
POSTGRES_USER=user
POSTGRES_PASSWORD=password
DDL_AUTO=update
SPRING_PROFILE=dev
